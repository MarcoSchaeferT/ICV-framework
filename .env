DATABASE_USER="icv_user"
DATABASE_URL_SECRET="postgresql://icv_user:icv_password1234@127.0.0.1:5333/icv-database?schema=public"
DATABASE_URL="postgresql://icv_user:icv_password1234@127.0.0.1:5333/icv-database?schema=public"
DB_PASSWORD_SECRET="icv_password1234"

# Locks write/mutation actions (file upload, DB management, metadata editor) with a demo dialog
DEMO_MODE=false

# Displays the introductory disclaimer popup/banner to visitors
SHOW_DISCLAIMER=false

# Toggles visibility of COVID-19 specific dashboards, sidebar links, and showcase cards
SHOW_COV=false

 # Shows or hides legal pages and footer links (Impressum / Imprint & Data Protection / Privacy)
SHOW_LEGAL_TEXTS=false

 # Enables layout template preview cards and layout switching options on the homepage
SHOW_LAYOUT_TEMPLATES=true

# Optional: Override Gunicorn backend worker count (default auto-calculated), note: 4 threads per worker
#GUNICORN_WORKERS=8
